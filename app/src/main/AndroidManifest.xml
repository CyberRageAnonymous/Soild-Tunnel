<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      SECURITY: the in-app updater is back, so this permission is back too —
      and it is the only runtime code-delivery path the app has. It is held
      to three constraints, all enforced in UpdateInstaller:
        1. the APK is fetched only from the official GitHub Release of this
           repository,
        2. before the installer is pointed at it, the file's signing
           certificate must match the one that signed the app already
           installed, so a tampered or foreign APK is discarded,
        3. the file lives behind a FileProvider path that exposes nothing
           but the update cache, and the URI grant lasts only for that one
           install intent.
      Without (2) this permission would turn a compromised download into
      code execution, which is exactly why it was removed before.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Split tunneling needs to list the device's launchable apps so the user
         can pick which apps to include/exclude from the tunnel. We only query
         launcher-visible apps (not QUERY_ALL_PACKAGES), which keeps Play policy
         happy and avoids the sensitive all-packages permission. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".SoildTunnelApp"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SoildTunnel">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density"
            android:theme="@style/Theme.SoildTunnel"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".vpn.SoildTunnelVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Runs the SoildTunnel censorship-circumvention VPN tunnel while active" />
        </service>

        <!-- Quick Settings tile: one-tap connect/disconnect from the shade. -->
        <service
            android:name=".vpn.SoildTunnelTileService"
            android:exported="true"
            android:icon="@drawable/ic_notification"
            android:label="@string/qs_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!--
          Home-screen widget (feature merge): one-tap connect /
          disconnect plus live status on the launcher. Not exported; only the
          system AppWidgetService delivers updates to it, and our toggle
          broadcast is sent with an explicit component, so no other app can
          trigger it. updatePeriodMillis=0 — repaints are pushed from the VPN
          service's state-change hook, never on a timer.
        -->
        <receiver
            android:name=".widget.SoildTunnelWidgetProvider"
            android:exported="false"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/soildtunnel_widget_info" />
        </receiver>

        <!--
          Crash report screen (feature merge): shows the fatal
          exception saved by SoildTunnelApp's crash handler on the previous run.
          Not exported; only MainActivity can open it.
        -->
        <activity
            android:name=".CrashReportActivity"
            android:exported="false"
            android:theme="@style/Theme.SoildTunnel" />

        <!--
          Exports the downloaded update APK to the system installer and
          nothing else: the paths file scopes it to the update cache, it is
          not exported, and the URI grant lasts only for the one install
          intent (see UpdateInstaller).
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
